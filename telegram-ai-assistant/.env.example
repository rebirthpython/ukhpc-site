# Токен от @BotFather. Никому не показывать и не коммитить.
BOT_TOKEN=

# Кому разрешён доступ: Telegram ID через запятую (узнать свой ID: @userinfobot)
ALLOWED_USER_IDS=123456789

# --- AI-провайдер (любой OpenAI-совместимый) ---
# OpenRouter: ключ на https://openrouter.ai/keys
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
# Модели по порядку: если первая недоступна/перегружена — пробуется следующая.
# Актуальный список бесплатных: https://openrouter.ai/models?max_price=0
AI_MODELS=meta-llama/llama-3.3-70b-instruct:free,openrouter/free

# Альтернатива — Gemini (ключ на https://aistudio.google.com/apikey):
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODELS=gemini-2.5-flash

# --- Лимиты ---
AI_MAX_TOKENS=1500
AI_TIMEOUT=60
HISTORY_LIMIT=30
HISTORY_MAX_CHARS=12000
RATE_LIMIT_PER_MINUTE=10
DAILY_REQUEST_LIMIT=45

DATABASE_URL=sqlite+aiosqlite:///bot.db
