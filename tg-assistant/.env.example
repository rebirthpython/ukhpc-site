# ============ ОБЯЗАТЕЛЬНО ============
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Ключ Claude API: https://console.anthropic.com -> API Keys (оплата с твоего аккаунта)
ANTHROPIC_API_KEY=
# Кому можно пользоваться ботом: Telegram ID через запятую (девушка и ты)
ALLOWED_USER_IDS=
# Твой Telegram ID: уведомления о новых людях, команда /stats
ADMIN_IDS=

# ============ МИНИ-ПРИЛОЖЕНИЕ (HTML5) ============
# Публичный HTTPS-адрес, где доступен сервер бота. Без него работает только чат.
WEBAPP_URL=
# Домен для автоматического HTTPS через Caddy (docker compose), например bot.example.com
DOMAIN=
PORT=8080

# ============ МОДЕЛЬ ============
CLAUDE_MODEL=claude-opus-5-5
# low — быстрее и дешевле, medium — баланс, high — глубже думает
CLAUDE_EFFORT=medium
MAX_TOKENS=16000
# Веб-поиск для свежих новостей, погоды, цен ($0.01 за поиск)
ENABLE_WEB_SEARCH=true

# ============ ЛИМИТЫ РАСХОДОВ (USD), 0 = без лимита ============
DAILY_BUDGET_USD=1
MONTHLY_BUDGET_USD=20
PER_USER_DAILY_BUDGET_USD=0

# ============ ПЕРСОНАЛИЗАЦИЯ ============
ASSISTANT_NAME=Луна
# Имя девушки — ассистент будет к ней так обращаться
USER_NAME=
# Твоё имя (необязательно) — ассистент будет знать, кто его подарил
OWNER_NAME=
USER_CITY=
TIMEZONE=Europe/Moscow
# Дополнительные инструкции можно положить в файл persona.txt (см. persona.example.txt)

# ============ ИСТОРИЯ ============
# Сколько сообщений хранить в контексте; при превышении старые обрезаются до TRIM_TO_MESSAGES
MAX_HISTORY_MESSAGES=60
TRIM_TO_MESSAGES=30

# Только для отладки мини-приложения в обычном браузере! В продакшене оставь пустым.
DEV_USER_ID=
